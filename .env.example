# Copy to `.env` (repo root) and fill in. `.env` is git-ignored and is read ONLY by the Node backend.
# The browser never sees these values.

# --- Server ---
PORT=8787
# Bind address. Keep 127.0.0.1: the Vite dev server proxies /api for the phone.
HOST=127.0.0.1

# --- OpenAI (Cloud preset) ---
# Without a key the `cloud` preset is reported as unavailable; `mock` still works.
OPENAI_API_KEY=
# Pinned model identifiers. Verify they are currently available for your account.
OPENAI_ASR_MODEL=gpt-4o-transcribe
OPENAI_LLM_MODEL=gpt-4.1-mini
# Photo vocabulary cards only. Must accept image input on the Responses API.
# Uses the same OPENAI_API_KEY. The identify call itself does not keep the photo.
OPENAI_VISION_MODEL=gpt-4.1-mini
# Household vocabulary library. Separate from the monitoring database.
# Words live in the sqlite file. Photos and speech live as files under the media directory.
VOCABULARY_DB_PATH=
VOCABULARY_MEDIA_DIR=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# 0 = deterministic-ish output. Leave EMPTY for reasoning models that reject `temperature`.
OPENAI_LLM_TEMPERATURE=0
# Per-call timeout (ms) and SDK retry count.
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# --- Dialogue policy knobs shared by ALL providers ---
# Whether the single previously delivered message is passed to the LLM as optional context.
# Use the same value for Cloud/Local comparisons.
PROMPT_MEMORY=on

# --- Evaluation logging (metadata only; never audio / transcripts / translations) ---
# Append events to apps/server/data/events.ndjson as well as keeping them in memory.
PERSIST_EVENTS=on

# ============================================================ v1.2: Mac-local provider (preset `local`)
# Local mode never calls a paid cloud service and never falls back to Cloud. Every engine is addressed on
# loopback ONLY (non-loopback URLs are rejected). Run `npm run local:doctor` to check this Mac.
# Set LOCAL_ENABLED=off to hide the `local` preset entirely.
LOCAL_ENABLED=on

# --- Ollama (understanding + translation). Install: brew install ollama && ollama pull qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_MS=90000

# --- whisper.cpp HTTP server (speech recognition). Install: brew install whisper-cpp
# `npm run local:start` launches whisper-server with this model on 127.0.0.1:8080.
WHISPER_BASE_URL=http://127.0.0.1:8080
WHISPER_MODEL=models/whisper/ggml-small.bin
WHISPER_BIN=whisper-server
WHISPER_TIMEOUT_MS=60000

# --- Audio conversion (browser AAC/Opus -> 16 kHz mono WAV) and TTS (macOS `say`)
FFMPEG_BIN=ffmpeg
SAY_BIN=say
# Leave the voices EMPTY to auto-detect an installed zh_* / sv_* voice (see `say -v '?'`).
LOCAL_TTS_VOICE_ZH=
LOCAL_TTS_VOICE_SV=
LOCAL_TTS_TIMEOUT_MS=30000
# Request-scoped temp files (0700, deleted after every request). Empty = OS temp dir.
LOCAL_TMP_DIR=
# How long a readiness probe is reused (ms).
LOCAL_PROBE_TTL_MS=2000

# ============================================================ v1.2: monitoring dashboard (/monitor)
# SQLite file with METADATA ONLY (timings, tokens, cost, status). Never audio, transcripts or translations.
MONITOR_DB_PATH=
# Admin password for /monitor, the CSV exports and the pilot-data purge. There is NO default password.
# Empty = a random password is generated once, printed once, and stored in apps/server/data/monitor-admin-password (0600).
MONITOR_ADMIN_PASSWORD=
# on = only this Mac can open /monitor (recommended unless you review from another device).
MONITOR_LOCAL_ONLY=off
MONITOR_SESSION_HOURS=12
# Price registry (JSON, hot-reloaded). Verify the rates against the vendor pages before trusting cost numbers.
PRICES_FILE=
